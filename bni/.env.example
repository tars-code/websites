# ─────────────────────────────────────────────────────────────
# Copy to .env.local for development. In production set these
# in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (share links, sitemap, OpenGraph).
# On Vercel this defaults to the production domain; set it when using a custom domain.
SITE_URL=http://localhost:3000

# Dev only: hostnames/IPs allowed to open `next dev` besides localhost,
# e.g. when the dev server runs on a remote VM. Comma-separated, no scheme or port.
DEV_ORIGINS=

# Session signing secret — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# First admin account. Used only until the first sign-in creates the account;
# after that, manage admins and passwords in Admin → Admins & password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Production database & photo storage (Supabase free tier) ──
# Leave empty in development to use the local JSON store in .data/
SUPABASE_URL=
# Server-only key (Project Settings → API → service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=chapter-media

# ── Optional: notify someone when a visit request arrives ──
# Any webhook that accepts JSON (Slack, Discord, Zapier, Make, Google Apps Script…)
VISIT_REQUEST_WEBHOOK_URL=
# Or email via Resend (free tier)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
